# =============================================================================
# Produzione — copia queste variabili su Vercel
# Project → Settings → Environment Variables
# Ambiente: Production (e Preview se serve)
# =============================================================================
# Blob: non incollare il token a mano se colleghi Storage → Blob al progetto:
# Vercel aggiunge da solo BLOB_READ_WRITE_TOKEN (e spesso BLOB_STORE_ID).
# Crea uno store NUOVO, non riusare quello di Iren Corner.
# =============================================================================

# --- Admin (diversi da quelli di sviluppo) ---
ADMIN_USERNAME="Plenitude"
ADMIN_PASSWORD="scegli-una-password-sicura-diversa-dal-locale"
SESSION_SECRET="stringa-casuale-lunga-almeno-32-caratteri"

# --- Email nuove candidature (Resend: https://resend.com) ---
RESEND_API_KEY="re_..."
RESEND_FROM="Plenitude Dealer <noreply@plenitudedealerita.it>"
NOTIFIER_EMAIL="codifiche@gruppoevolvia.it"

# --- URL pubblico (dominio custom o URL Vercel) ---
APP_URL="https://www.plenitudedealerita.it"

# --- Titolare del trattamento (Privacy / Cookie Policy) ---
LEGAL_ENTITY_NAME="Futuro Green SRL"
LEGAL_ENTITY_ADDRESS="Indirizzo completo della società"
LEGAL_ENTITY_VAT="Partita IVA"
LEGAL_PRIVACY_EMAIL="privacy@plenitudeleader.it"
